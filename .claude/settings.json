{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm test)",
      "Bash(npm test -- *)",
      "Bash(npx playwright test*)",
      "Bash(npx playwright show-report*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(git reset*)",
      "Bash(git checkout*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow run*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./**/.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git push --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(git filter-branch*)",
      "Bash(npm publish*)",
      "Bash(gh release create*)",
      "Bash(gh repo delete*)",
      "Bash(vercel*)",
      "Bash(netlify deploy*)",
      "Bash(fly deploy*)",
      "Bash(railway up*)",
      "Bash(docker push*)",
      "Bash(kubectl*)",
      "Bash(aws *)",
      "Bash(gcloud *)",
      "Bash(rm -rf *)",
      "Bash(curl * | sh)",
      "Bash(curl * | bash)"
    ]
  }
}
