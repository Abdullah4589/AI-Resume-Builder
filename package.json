{
  "name": "ai-resume-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm -w client run dev",
    "dev:server": "npm -w server run dev",
    "serve:server": "npm -w server run serve",
    "build": "npm -w client run build && npm -w server run build",
    "typecheck": "npm -w client run typecheck && npm -w server run typecheck",
    "start": "npm -w server run start",
    "test": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "puppeteer@24.43.1": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true
  }
}
